# Question:
Find matching pairs of Meta/Facebook employees such that they are both of the same nation,
different age, same gender, and at different seniority levels. Output IDs of paired employees.

# Solution:
import pandas as pd
df = facebook_employees

df = (
        pd.merge(df, facebook_employees, how='inner', on=['location','gender'])
        .rename(columns={'id_x':'emp_1',
                         'id_y':'emp_2',
                         'age_x':'emp_1_age',
                         'age_y':'emp_2_age',
                         'is_senior_x':'emp_1_seniority',
                         'is_senior_y':'emp_2_seniority'})
     )

df = (
        df.loc[
                ~(df['emp_1'] == df['emp_2']) &
                ~(df['emp_1_age'] == df['emp_2_age']) &
                ~(df['emp_1_seniority'] == df['emp_2_seniority']), ['emp_1', 'emp_2']
              ].sort_values('emp_1').drop_duplicates()
      )

